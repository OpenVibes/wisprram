{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"], "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "resolveJsonModule": true, "isolatedModules": true, "noEmit": true,
    "paths": { "@shared/*": ["./src/shared/*"] }
  },
  "include": ["electron.vite.config.ts", "vite.mock.config.ts", "src/main/**/*", "src/preload/**/*", "src/shared/**/*"]
}
